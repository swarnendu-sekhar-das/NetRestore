# Git Ignore Configuration for NetRestore Project
# This file specifies intentionally untracked files that Git should ignore.
# Patterns are grouped by category for maintainability.

# Python Build Artifacts
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
# Local environment variables (contains secrets)
.env
.venv
env/
venv/
ENV/
.ci-env/      # CI/CD temporary environment

# Jupyter Notebook Checkpoints
.ipynb_checkpoints

# Operating System Artifacts
.DS_Store
Thumbs.db

# Project-Specific Artifacts
api.txt
data/sops/*.pdf
data/network_topology.json
data/eval_dataset.json
chroma_db/
shared_data/

# DevOps Security Exclusions
vault/
*.pem
*.key
*.crt
*.tfstate
*.tfstate.backup
.terraform/

# Development Artifacts
scratch/
evaluation_results.json
