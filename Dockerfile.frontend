FROM python:3.11-slim

WORKDIR /app

# System dependencies
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install uv
RUN pip install --no-cache-dir uv

# We only need Streamlit, requests, and python-dotenv for the frontend.
# But for simplicity in this project we'll just install from the main requirements
COPY requirements.txt .
RUN uv pip install --system --no-cache --index-strategy unsafe-best-match --extra-index-url https://download.pytorch.org/whl/cpu streamlit requests python-dotenv

# Copy only frontend application code
COPY src/app/ src/app/

# We don't need data or models here
ENV PYTHONPATH=/app

# Streamlit port
EXPOSE 8501

# Run Streamlit
CMD ["streamlit", "run", "src/app/main.py", "--server.port", "8501", "--server.address", "0.0.0.0"]
